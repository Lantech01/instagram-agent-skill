  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bn[aã]o [ée] (?:s[oó]|apenas|somente) [^.!?\\n]{2,60}[,.;:]\\s*(?:e sim|é)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Corte a metade que só prepara o terreno."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bn[aã]o (?:s[oó]|apenas|somente)\\b[^.!?\\n]{2,80}\\b(?:mas|como) tamb[eé]m\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebre em duas frases, ou corte a metade mais fraca."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\bn[aã]o (?:[ée] sobre|se trata de) [^.!?\\n]{2,60}[,.!;]\\s*(?:é sobre|se trata de|mas sim|mas de)\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A virada é o que entrega o texto."
    },
    {
      "id": "the-result",
      "regex": "(?im)^\\s*(?:e )?(?:o resultado|a melhor parte|o melhor|o pior|o segredo|o problema|a pegadinha|o detalhe|o motivo|a diferen[cç]a|a sacada|por qu[eê] isso importa)\\?|^\\s*(?:alerta de )?spoiler(?: alert)?\\s*[:!]|\\bsabe (?:o que [ée] (?:o )?mais \\w+|qual [ée] o (?:segredo|problema|truque))\\?",
      "name": "Revelação encenada (\"O resultado?\", \"E o melhor?\", \"Spoiler:\")",
      "fix": "Responda direto na frase em vez de montar suspense."
    },
    {
      "id": "heres-what",
      "regex": "(?im)\\b(?:aqui est[aá]|veja|olha|confira|isso [ée]) o que (?:eu )?aprendi\\b|(?:^|(?<=[.!?] ))\\s*a verdade (?:[ée] que|nua e crua)\\b|\\bvou ser (?:sincer[oa]|honest[oa])(?: com voc[eê])?\\s*[:,]",
      "name": "Anúncio antes do ponto (\"A verdade é que\", \"Aqui está o que eu aprendi\")",
      "fix": "Diga a coisa. O anúncio só atrasa."
    },
    {
      "id": "triad",
      "regex": "\\b\\w{3,}, \\w{3,},? e \\w{3,}[.!]",
      "name": "Trio de palavras (\"foco, disciplina e constância\")",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e nenhum desses cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Paredão de hashtags (5 ou mais)",
      "fix": "Três hashtags específicas. Paredão de hashtag é cara de post feito por template."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\b(?:como|enquanto|sou) uma? (?:ia|intelig[eê]ncia artificial|modelo de linguagem)\\b|\\bn[aã]o tenho (?:opini[oõ]es|sentimentos|emo[cç][oõ]es) pr[oó]pri[ao]s\\b",
      "name": "Modelo falando de si (\"Como uma IA...\")",
      "fix": "Apague a frase inteira."
    },
    {
      "id": "in-summary",
      "regex": "(?im)^\\s*(?:em suma|em resumo|em s[ií]ntese|em conclus[aã]o|para concluir|pra concluir|concluindo|resumindo tudo)\\b",
      "name": "Fecho de redação escolar (\"Em resumo\", \"Para concluir\")",
      "fix": "Post não precisa de parágrafo de conclusão. Termine no último ponto que importa."
    },
    {
      "id": "engagement-bait",
      "regex": "(?im)\\b(?:concorda(?:m)?(?: comigo)?|faz sentido|o que (?:voc[eê]s )?acham|o que acha|e voc[eê],? o que acha|e voc[eê]s|quem mais[^.!?\\n]{0,40}|(?:t[oô]|estou) errad[oa]|j[aá] passou por isso|algu[eé]m mais)\\?\\s*$",
      "name": "Isca de engajamento no automático (\"Concorda?\", \"Faz sentido?\", \"E vocês?\")",
      "fix": "Faça uma pergunta que só você faria, sobre a coisa específica que vem antes dela."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:(?:espera|calma|ei)[,.!]?\\s+)?(?:para|pare) de (?:rolar|passar)\\b|^\\s*(?:(?:espera|calma|ei)[,.!]?\\s+)?n[aã]o (?:passa|passe|pula|pule|rola|role)(?: (?:esse|este|o) (?:v[ií]deo|reels?|post)\\b|\\s*[!,.])",
      "name": "Abertura \"Para de rolar o feed\"",
      "fix": "O que segura o dedo tem que ser a própria afirmação. Pedir atenção é admitir que o texto ainda não merece."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:(?:neste|nesse) (?:v[ií]deo|reels?|post|carrossel),? (?:eu )?(?:vou|vamos|voc[eê] vai|te mostro|te ensino)|no (?:v[ií]deo|reels?|post|carrossel) de hoje|hoje (?:eu )?vou te (?:mostrar|ensinar|contar|explicar)|vou te (?:mostrar|ensinar) como)\\b",
      "name": "Preâmbulo de vídeo (\"No vídeo de hoje eu vou te mostrar\")",
      "fix": "Apague e comece na entrega. Os dois primeiros segundos decidem o Reels inteiro."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista com emoji no lugar do marcador",
      "fix": "Use hífen ou quebra de linha. Emoji como marcador é a coisa com mais cara de template numa legenda."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-ZÀ-ÖØ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-ÖØ-Ý]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é botão de volume, não marca-texto. Uma palavra, no máximo."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:segue (?:pra|para) mais|siga (?:pra|para) mais|me segue (?:pra|para)|marca (?:algu[eé]m|aquele amigo|aquela amiga|um amigo|uma amiga|quem)|marque (?:algu[eé]m|um amigo|uma amiga|quem)|salv[ae] (?:esse|este) (?:post|v[ií]deo|reels?|carrossel)|deix[ae] (?:seu|o) like|compartilh[ae] com quem|manda (?:pra|para) quem)\\b",
      "name": "Pedido de follow ou de marcação no automático",
      "fix": "Peça a única ação que este post merece. O pedido genérico ensina a audiência a ignorar todos os pedidos."
    },
    {
      "id": "voce-ja",
      "regex": "(?im)\\bvoc[eê] j[aá] (?:se perguntou|parou (?:pra|para) pensar|imaginou)\\b|^\\s*imagin[ea] (?:s[oó]|isso|a cena)\\b|\\bimagine um mundo\\b",
      "name": "Gancho hipotético (\"Você já se perguntou...?\", \"Imagine só\")",
      "fix": "Troque a pergunta pela resposta. Comece no fato concreto, não na hipótese."
    },
    {
      "id": "seja-voce",
      "regex": "(?i)\\bseja voc[eê] (?:um |uma )?\\w+[^.!?\\n]{0,40}?\\bou\\b",
      "name": "\"Seja você X ou Y\"",
      "fix": "Escreva pra uma pessoa só. Texto que fala com todo mundo não fala com ninguém."
    }
  ]
